;min-height:62px;display:grid;align-content:center;padding:9px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(5,13,24,.82);font:12px/1.3 var(--mono);text-align:center}.ledger__label{justify-content:start;color:var(--ui);font-weight:800;text-align:left}.ledger [data-kind="main"]{color:var(--main)}.ledger [data-kind="data"]{color:var(--data)}.ledger [data-kind="guard"]{color:var(--guard);border-style:dashed}.ledger [data-kind="fail"]{color:var(--fail);border-style:double}.ledger [data-kind="off"]{color:var(--off);border-style:dotted}.accept-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;border:1px solid var(--line);background:var(--line)}.accept-field{padding:13px;background:var(--surface)}.accept-field code{display:block;color:var(--data);font-size:12px}.accept-field b{display:block;margin-top:4px;color:var(--text);font-size:13px}.accept-field span{display:block;margin-top:6px;color:var(--muted);font-size:12px}.topic-link{display:block;margin-top:18px;padding:15px;border:1px solid var(--data);background:rgba(93,159,255,.06);text-decoration:none}.topic-link b{display:block;color:var(--data)}.topic-link span{display:block;margin-top:6px;color:var(--muted);font-size:12px}@media(max-width:900px){.accept-fields{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.accept-fields{grid-template-columns:1fr}}
