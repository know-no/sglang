<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>dSpark V2 · 拒绝采样修正实验室</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="assets/dspark-visual-system.css">
  <style>
    .dist-lab{min-width:980px;display:grid;grid-template-columns:repeat(3,minmax(285px,1fr));gap:16px}.dist-card{--tone:var(--data);padding:15px;border:1px solid var(--tone);background:var(--surface)}.dist-card[data-kind="main"]{--tone:var(--main)}.dist-card[data-kind="guard"]{--tone:var(--guard);border-style:dashed}.dist-card h3{margin:0 0 12px;color:var(--tone);font:800 13px/1.35 var(--mono)}.mini-bar{display:grid;grid-template-columns:24px 1fr 52px;gap:8px;align-items:center;margin:8px 0;font:12px/1.2 var(--mono)}.mini-bar i{height:18px;border:1px solid var(--line);background:linear-gradient(90deg,var(--tone) var(--p),transparent var(--p));font-style:normal}.math-chain{display:grid;grid-template-columns:repeat(5,minmax(170px,1fr));gap:25px;min-width:1020px}.math-node{--tone:var(--data);position:relative;min-height:150px;padding:14px;border:1px solid var(--tone);background:var(--surface)}.math-node[data-kind="main"]{--tone:var(--main)}.math-node[data-kind="guard"]{--tone:var(--guard);border-style:dashed}.math-node[data-kind="fail"]{--tone:var(--fail);border-style:double}.math-node:not(:last-child)::after{content:"→";position:absolute;right:-20px;top:44%;color:var(--main);font:900 18px/1 var(--mono)}.math-node b{display:block;color:var(--tone);font:800 12px/1.3 var(--mono)}.math-node code,.math-node span{display:block;margin-top:8px;color:var(--muted);font-size:12px}.cdf{position:relative;height:76px;margin-top:14px;border:1px solid var(--line);display:grid;grid-template-columns:5fr 1fr}.cdf__b{display:grid;place-items:center;background:rgba(98,245,154,.12);color:var(--main);border-right:2px solid var(--guard)}.cdf__c{display:grid;place-items:center;background:rgba(93,159,255,.15);color:var(--data)}.cdf__marker{position:absolute;left:90%;top:-8px;bottom:-8px;width:2px;background:var(--fail);transition:left .2s}.cdf__marker::before{content:"u";position:absolute;top:-18px;left:-4px;color:var(--fail);font:800 11px/1 var(--mono)}.sample-control{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;margin-top:16px;padding:14px;border:1px dashed var(--guard);background:rgba(255,208,96,.04)}.sample-control input{width:100%;accent-color:var(--guard)}.sample-result{min-width:180px;color:var(--main);font:800 13px/1.35 var(--mono)}.compare-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.compare-card{padding:14px;border:1px solid var(--line);background:var(--surface)}.compare-card b{display:block;color:var(--data)}.compare-card span{display:block;margin-top:7px;color:var(--muted);font-size:12px}@media(max-width:760px){.compare-grid{grid-template-columns:1fr}.sample-control{grid-template-columns:1fr}}
  </style>
  <link rel="stylesheet" href="assets/dspark-source-studio.css">
  <script src="assets/dspark-site.js" defer></script>
  <script src="assets/dspark-learning-layer.js" defer></script>
  <script src="assets/dspark-source-studio.js" defer></script>
