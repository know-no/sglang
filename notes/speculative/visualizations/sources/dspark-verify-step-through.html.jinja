<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self' file:; style-src 'self' 'unsafe-inline' file:; script-src 'self' file:; img-src 'self' data: file:; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'">
  <title>05 · Target Verify · dSpark V2</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="assets/dspark-visual-system.css">
  <style>
    .verify-sequence { min-width: 1440px; }
    .verify-sequence__heads {
      display: grid;
      grid-template-columns: 96px repeat(8, minmax(0, 1fr));
      border-top: 1px solid var(--line);
      border-left: 1px solid var(--line);
    }
    .verify-sequence__corner,
    .verify-sequence__head {
      min-width: 0;
      min-height: 154px;
      padding: 12px 10px;
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      background: var(--surface-2);
    }
    .verify-sequence__corner {
      display: grid;
      align-content: end;
      color: var(--faint);
      font: 800 12px/1.35 var(--mono);
    }
    .verify-sequence__head .instance {
      display: block;
      color: var(--data);
      font: 800 12px/1.35 var(--mono);
      overflow-wrap: anywhere;
    }
    .verify-sequence__head .class-name {
      display: block;
      margin-top: 7px;
      color: var(--text);
      font: 800 12px/1.35 var(--mono);
      overflow-wrap: anywhere;
    }
    .verify-sequence__head .fqcn {
      display: block;
      margin-top: 7px;
      color: var(--muted);
      font: 12px/1.35 var(--mono);
      overflow-wrap: anywhere;
    }
    .verify-sequence__body {
      position: relative;
      width: 1440px;
      height: 1100px;
      border-left: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      background:
        linear-gradient(90deg, transparent 95px, var(--line) 96px, transparent 97px),
        repeating-linear-gradient(90deg, transparent 0 167px, rgba(42, 64, 94, .72) 168px 169px),
        repeating-linear-gradient(0deg, rgba(93, 159, 255, .018) 0 79px, rgba(42, 64, 94, .55) 80px 81px);
    }
    .verify-sequence__body svg { width: 1440px; height: 1100px; display: block; overflow: visible; }
    .seq-call, .seq-return, .seq-cuda, .seq-meta, .seq-guard {
      fill: none;
      stroke-width: 2.4;
      vector-effect: non-scaling-stroke;
    }
    .seq-call { stroke: var(--main); }
    .seq-return { stroke: var(--main); stroke-dasharray: 3 6; }
    .seq-cuda { stroke: var(--cuda); stroke-dasharray: 9 7; }
    .seq-meta { stroke: var(--data); }
    .seq-guard { stroke: var(--guard); stroke-dasharray: 7 6; }
    .seq-activation { fill: rgba(98, 245, 154, .08); stroke: var(--main); }
    .seq-label-bg { fill: var(--bg); opacity: .96; }
    .seq-label {
      fill: var(--text);
      font: 12px/1.3 var(--mono);
      paint-order: stroke;
      stroke: var(--bg);
      stroke-width: 4px;
      stroke-linejoin: round;
    }
    .seq-label--data { fill: var(--data); }
    .seq-label--guard { fill: var(--guard); }
    .seq-label--cuda { fill: var(--cuda); }
    .seq-note { fill: var(--muted); font: 12px/1.3 var(--mono); }
    .seq-phase { fill: var(--ui); font: 800 12px/1.3 var(--mono); letter-spacing: .08em; }
    .route-contract { margin: 0 0 22px; }
    .route-contract .route-stop { min-height: 54px; }
    .verify-transform { grid-template-columns: repeat(6, minmax(180px, 1fr)); min-width: 1310px; }
    .transform-stage { min-height: 276px; }
    .transform-stage .shape {
      display: block;
      margin-top: 8px;
      color: var(--text);
      font: 800 12px/1.35 var(--mono);
    }
    .mini-grid { display: grid; gap: 4px; margin-top: 12px; }
    .mini-grid--5 { grid-template-columns: repeat(5, 1fr); }
    .mini-grid--4 { grid-template-columns: repeat(4, 1fr); }
    .mini-grid--10 { grid-template-columns: repeat(5, 1fr); }
    .mini-token {
      min-height: 34px;
      display: grid;
      place-items: center;
      padding: 4px;
      border: 1px solid var(--data);
      color: var(--data);
      background: rgba(93, 159, 255, .04);
      font: 12px/1.2 var(--mono);
      text-align: center;
    }
    .mini-token[data-kind="main"] { color: var(--main); border-color: var(--main); }
    .mini-token[data-kind="cuda"] { color: var(--cuda); border-color: var(--cuda); border-style: dashed; }
    .mini-token[data-kind="off"] { color: var(--off); border-color: var(--off); border-style: dotted; background: rgba(4, 8, 15, .7); }
    .route-variant {
      margin-top: 10px;
      padding: 8px;
      border-left: 3px solid var(--guard);
      color: var(--muted);
      background: rgba(255, 208, 96, .035);
      font: 12px/1.4 var(--mono);
    }
    .result-pair { display: grid; gap: 8px; margin-top: 13px; }
    .result-object {
      padding: 9px;
      border: 1px solid var(--data);
      color: var(--data);
      font: 12px/1.35 var(--mono);
      overflow-wrap: anywhere;
    }
    .result-object[data-kind="main"] { border-color: var(--main); color: var(--main); }
    .output-rails { margin-top: 24px; }
    .output-rails .token-rail + .token-rail { border-top: 0; }
    .next-consumers { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 22px; }
    .next-consumer {
      min-width: 0;
      padding: 15px;
      border: 1px solid var(--line);
      background: var(--surface);
      text-decoration: none;
    }
    .next-consumer:hover { border-color: var(--ui); }
    .next-consumer b { display: block; color: var(--main); font: 800 12px/1.35 var(--mono); }
    .next-consumer span { display: block; margin-top: 7px; color: var(--muted); font-size: 12px; }
    .boundary-note {
      margin-top: 18px;
      padding: 12px 14px;
      border-left: 4px double var(--fail);
      background: rgba(255, 94, 127, .035);
      color: var(--muted);
      font-size: 12px;
    }
    .metadata-contract {
      display: grid;
      grid-template-columns: minmax(210px, .8fr) minmax(0, 2.2fr);
      gap: 16px;
      margin: 18px;
      padding: 15px;
      border: 1px solid var(--data);
      background: rgba(93, 159, 255, .045);
    }
    .metadata-contract b, .metadata-contract code { color: var(--data); }
    .metadata-contract p { margin: 5px 0 0; color: var(--muted); font-size: 12px; }
    .metadata-contract__owner { font: 12px/1.45 var(--mono); overflow-wrap: anywhere; }
    .retained-insights {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
      gap: 18px;
      margin-top: 26px;
    }
    .teaching-panel {
      min-width: 0;
      padding: 18px;
      border: 1px solid var(--line);
      background: var(--surface);
    }
    .teaching-panel h3 { margin: 0; font-size: 17px; }
    .teaching-panel > p { margin: 8px 0 0; color: var(--muted); font-size: 12px; }
    .alignment-table,
    .geometry-table {
      min-width: 660px;
      margin-top: 15px;
      border-collapse: collapse;
      table-layout: fixed;
      font: 12px/1.4 var(--mono);
    }
    .alignment-table th,
    .alignment-table td,
    .geometry-table th,
    .geometry-table td {
      padding: 9px 8px;
      border: 1px solid var(--line);
      text-align: center;
      overflow-wrap: anywhere;
    }
    .alignment-table th:first-child,
    .alignment-table td:first-child,
    .geometry-table th:first-child,
    .geometry-table td:first-child {
      width: 144px;
      color: var(--muted);
      text-align: left;
    }
    .alignment-table thead th,
    .geometry-table thead th { color: var(--ui); background: var(--surface-2); }
    .alignment-table .input-cell { color: var(--data); border-color: var(--data); }
    .alignment-table .prediction-cell { color: var(--main); border-color: var(--main); }
    .geometry-table code { color: var(--data); }
    .field-inspector {
      display: grid;
      grid-template-columns: repeat(4, minmax(200px, 1fr));
      gap: 0;
      min-width: 920px;
      margin-top: 15px;
      border: 1px solid var(--line);
    }
    .field-snapshot {
      min-width: 0;
      padding: 14px;
      border-right: 1px solid var(--line);
      background: var(--surface-2);
    }
    .field-snapshot:last-child { border-right: 0; }
    .field-snapshot b { display: block; color: var(--data); font: 800 12px/1.35 var(--mono); }
    .field-snapshot[data-kind="guard"] b { color: var(--guard); }
    .field-snapshot[data-kind="main"] b { color: var(--main); }
    .field-snapshot[data-kind="off"] b { color: var(--off); }
    .field-snapshot p { margin: 8px 0 0; color: var(--muted); font-size: 12px; }
    .mode-boundary {
      margin-top: 15px;
      padding: 12px 14px;
      border-left: 3px dashed var(--guard);
      color: var(--muted);
      background: rgba(255, 208, 96, .035);
      font-size: 12px;
    }
    .code-journey {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 18px;
    }
    .code-journey article { min-width: 0; border: 1px solid var(--line); background: #020711; }
    .code-journey h3 { margin: 0; padding: 10px 12px; border-bottom: 1px solid var(--line); color: var(--ui); font: 800 12px/1.35 var(--mono); }
    .code-journey pre { margin: 0; padding: 12px; overflow: auto; color: #dce9f8; font: 12px/1.5 var(--mono); }
    @media (max-width: 600px) {
      .next-consumers { grid-template-columns: 1fr; }
      .metadata-contract { grid-template-columns: 1fr; }
      .retained-insights { grid-template-columns: 1fr; }
    }
    @media (max-width: 980px) { .code-journey { grid-template-columns: 1fr; } }
  </style>
  <link rel="stylesheet" href="assets/dspark-source-studio.css">
  <script src="assets/dspark-site.js" defer></script>
  <script src="assets/dspark-learning-layer.js" defer></script>
  <script src="assets/dspark-source-studio.js" defer></script>
  <script src="assets/dspark-stepper.js" defer></script>
</head>
<body data-page="05">
  <nav data-site-nav aria-label="dSpark 学习页面"></nav>

  <main class="page page--wide">
    <header class="hero">
      <p class="eyebrow">05 · Target 验证</p>
      <h1>Target 只负责前向计算；验证结果先回到 dSpark，再由后继阶段接受与提交</h1>
      <p class="lead"><code>anchor + draft</code> 被组织为 Target 的验证行；本页停在 <code>TargetVerifyResult + hidden_strided</code>，不提前执行接受判断。</p>
      <div class="evidence-strip">
        <span><strong>关键不变量</strong> · 第 i 行的 logits 预测第 i+1 个候选 token</span>
        <span><strong>后端边界</strong> · CUDA/ROCm 通用 <code>TpModelWorker</code>，PP=1；折叠尾处理器仅支持 NVIDIA CUDA</span>
        <span><strong>证据范围</strong> · 源码版本 <code>f01a0c7f97ec</code> · 已完成静态源码核验</span>
      </div>
      <div class="route-switch" aria-label="选择讲解路线">
        <button type="button" data-route-choice="static-greedy">STATIC · 贪心</button>
        <button type="button" data-route-choice="compact-sampling">COMPACT · 随机采样</button>
        <button type="button" data-route-choice="folded-greedy">FOLDED · 贪心</button>
      </div>
      <div data-semantic-legend></div>
    </header>

    <section class="handoff" aria-label="Target Verify 交接契约">
      <div class="handoff__item">
        <b>输入 · 数据</b>
        <span><code>DraftProposal</code>、<code>verify_ids_2d</code>、<code>VerifyWindow</code>，压紧路线另有 <code>RaggedVerifyLayout</code>。</span>
      </div>
      <div class="handoff__item">
        <b>准备 · 分支条件</b>
        <span><code>verify_input : DFlashVerifyInput</code> 临时把同一 <code>ScheduleBatch</code> 装配成 <code>TARGET_VERIFY</code>。</span>
      </div>
      <div class="handoff__item">
        <b>输出 · 主链</b>
        <span><code>TargetVerifyResult(logits_output, can_run_cuda_graph)</code>；压紧路线另返回 <code>hidden_strided</code>。</span>
      </div>
      <div class="handoff__item">
        <b>下一消费者 · 主链</b>
        <span>06 消费 logits 做接受/修正；07 消费辅助 hidden 并提交 Draft KV。</span>
      </div>
    </section>

    <section class="section" aria-labelledby="call-flow-title">
      <div class="section__head">
        <p class="section__kicker">主视图 · 调用泳道</p>
        <h2 id="call-flow-title">同一次 Target 验证，分轨显示 Python 调用、元数据规划与 CUDA 异步入队</h2>
        <p class="section__intro">每条泳道写出真实实例与具体类。黄色分支条件只决定执行器；它不会改变候选 token 的语义顺序。</p>
      </div>

      <div class="route-ribbons route-contract" aria-label="三条路线的物理执行差异">
        <div class="route-ribbon" data-routes="static-greedy">
          <div class="route-ribbon__name">STATIC · 贪心</div>
          <div class="route-ribbon__flow">
            <span class="route-stop">2×5 候选</span>
            <span class="route-stop">run_non_compact</span>
            <span class="route-stop">Target 前向计算 · 10 行</span>
            <span class="route-stop">已是固定步长 · 无需散射</span>
          </div>
        </div>
        <div class="route-ribbon" data-routes="compact-sampling">
          <div class="route-ribbon__name">COMPACT · 随机采样</div>
          <div class="route-ribbon__flow">
            <span class="route-stop">收集 · 4 个逻辑行</span>
            <span class="route-stop" data-kind="cuda">填充 · 5 个物理行</span>
            <span class="route-stop">Target 前向计算 · 5 行</span>
            <span class="route-stop">散射 · CUDA 图 + 尾处理器；否则显式内核</span>
          </div>
        </div>
        <div class="route-ribbon" data-routes="folded-greedy">
          <div class="route-ribbon__name">FOLDED · 贪心 · 仅 CUDA</div>
          <div class="route-ribbon__flow">
            <span class="route-stop">收集 · 4 个逻辑行</span>
            <span class="route-stop" data-kind="guard">压紧 + CUDA 图 + is_cuda()</span>
            <span class="route-stop" data-kind="cuda">DSparkVerifyEpilogue</span>
            <span class="route-stop">图内散射 · 10 个固定位置</span>
          </div>
        </div>
      </div>

      <div class="visual">
        <div class="visual__bar">
          <span><strong>调用时序</strong> · 接收者 → 方法(参数) → 返回值 → 下一接收者</span>
          <button class="zoom-button" type="button" data-zoom-target="#verify-call-flow">放大主图</button>
        </div>
        <div class="visual__body canvas-scroll" id="verify-call-flow">
          <div class="verify-sequence" role="group" aria-label="Target Verify 调用泳道">
            <div class="verify-sequence__heads">
              <div class="verify-sequence__corner">CPU 时间<br>↓</div>
              <div class="verify-sequence__head">
                <span class="instance">self</span>
                <span class="class-name">DSparkWorkerV2</span>
                <span class="fqcn">sglang.srt.speculative.dspark_components.dspark_worker_v2.DSparkWorkerV2</span>
              </div>
              <div class="verify-sequence__head">
                <span class="instance">self._verify_executor</span>
                <span class="class-name">TargetVerifyExecutor</span>
                <span class="fqcn">sglang.srt.speculative.dspark_components.dspark_verify.TargetVerifyExecutor</span>
              </div>
              <div class="verify-sequence__head">
                <span class="instance">verify_input</span>
                <span class="class-name">DFlashVerifyInput</span>
                <span class="fqcn">sglang.srt.speculative.dflash_info.DFlashVerifyInput</span>
              </div>
              <div class="verify-sequence__head">
                <span class="instance">verify_forward_batch</span>
                <span class="class-name">ForwardBatch</span>
                <span class="fqcn">sglang.srt.model_executor.forward_batch_info.ForwardBatch</span>
              </div>
              <div class="verify-sequence__head">
                <span class="instance">target_worker</span>
                <span class="class-name">TpModelWorker</span>
                <span class="fqcn">sglang.srt.managers.tp_worker.TpModelWorker</span>
              </div>
              <div class="verify-sequence__head">
                <span class="instance">target_worker.model_runner</span>
                <span class="class-name">ModelRunner</span>
                <span class="fqcn">sglang.srt.model_executor.model_runner.ModelRunner</span>
              </div>
              <div class="verify-sequence__head">
                <span class="instance">decode_cuda_graph_runner（含 .backend）/ eager_runner</span>
                <span class="class-name">DecodeCudaGraphRunner / CUDA 图后端 / EagerRunner 即时执行器</span>
                <span class="fqcn">sglang.srt.model_executor.runner.decode_cuda_graph_runner.DecodeCudaGraphRunner<br>sglang.srt.model_executor.runner_backend.full_cuda_graph_backend.FullCudaGraphBackend | runner_backend.breakable_cuda_graph_backend.BreakableCudaGraphBackend<br>sglang.srt.model_executor.runner.eager_runner.EagerRunner</span>
              </div>
              <div class="verify-sequence__head">
                <span class="instance">target_model := target_worker.model_runner.model<br>attn_backend := target_worker.model_runner.attn_backend</span>
                <span class="class-name">按模型选择的 Target 模型 / 注意力后端</span>
                <span class="fqcn">模型对应的 torch.nn.Module<br>sglang.srt.layers.attention.base_attn_backend.AttentionBackend</span>
              </div>
            </div>

            <div class="verify-sequence__body">
              <svg viewBox="0 0 1440 1100" role="img" aria-labelledby="verify-seq-title verify-seq-desc">
                <title id="verify-seq-title">Target 验证从 DSparkWorkerV2 到 Target ModelRunner 的调用序列</title>
                <desc id="verify-seq-desc">展示非压紧、压紧与折叠路线共享的 ForwardBatch 装配、元数据规划、解码 CUDA 图或即时执行器分派，以及 TargetVerifyResult 返回。</desc>
                <defs>
                  <marker id="seq-arrow-main" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="#62f59a"/></marker>
                  <marker id="seq-arrow-data" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="#5d9fff"/></marker>
                  <marker id="seq-arrow-guard" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="#ffd060"/></marker>
                  <marker id="seq-arrow-cuda" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="#c36cff"/></marker>
                </defs>

                <text class="seq-phase" x="18" y="34">装配</text>
                <rect class="seq-activation" x="172" y="20" width="10" height="1050" rx="4"/>
                <rect class="seq-activation" x="339" y="72" width="10" height="970" rx="4"/>
                <rect class="seq-activation" x="506" y="166" width="10" height="250" rx="4"/>
                <rect class="seq-activation" x="674" y="244" width="10" height="154" rx="4"/>
                <rect class="seq-activation" x="841" y="454" width="10" height="440" rx="4"/>
                <rect class="seq-activation" x="1008" y="510" width="10" height="370" rx="4"/>
                <rect class="seq-activation" x="1175" y="570" width="10" height="300" rx="4"/>
                <rect x="1342" y="298" width="10" height="438" rx="4" fill="rgba(93,159,255,.08)" stroke="#5d9fff"/>

                <g data-routes="static-greedy">
                  <line class="seq-call" x1="177" y1="82" x2="344" y2="82" marker-end="url(#seq-arrow-main)"/>
                  <rect class="seq-label-bg" x="205" y="57" width="276" height="20"/>
                  <text class="seq-label" x="207" y="72">run_non_compact(batch, verify_ids_2d, VerifyWindow)</text>
                </g>
                <g data-routes="compact-sampling folded-greedy">
                  <line class="seq-call" x1="177" y1="110" x2="344" y2="110" marker-end="url(#seq-arrow-main)"/>
                  <rect class="seq-label-bg" x="205" y="114" width="314" height="20"/>
                  <text class="seq-label" x="207" y="129">run_compact(batch, layout, draft_block_ids, draft_tokens)</text>
                </g>

                <line class="seq-meta" x1="344" y1="176" x2="511" y2="176" marker-end="url(#seq-arrow-data)"/>
                <rect class="seq-label-bg" x="364" y="151" width="285" height="20"/>
                <text class="seq-label seq-label--data" x="366" y="166">DFlashVerifyInput(draft_token, positions, FULL)</text>

                <line class="seq-call" x1="344" y1="226" x2="511" y2="226" marker-end="url(#seq-arrow-main)"/>
                <rect class="seq-label-bg" x="365" y="231" width="332" height="20"/>
                <text class="seq-label" x="367" y="246">prepare_for_verify(batch, target_worker)</text>

                <line class="seq-meta" x1="511" y1="280" x2="679" y2="280" marker-end="url(#seq-arrow-data)"/>
                <rect class="seq-label-bg" x="529" y="255" width="342" height="20"/>
                <text class="seq-label seq-label--data" x="531" y="270">ForwardBatch.init_new(..., capture_hidden_mode=FULL)</text>

                <path class="seq-guard" d="M511 328 H1098 Q1180 328 1180 354" marker-end="url(#seq-arrow-guard)"/>
