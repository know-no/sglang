  <style>
    .overlay-map{position:relative;min-width:1260px;min-height:520px;padding:210px 18px 30px}.normal-chain{display:grid;grid-template-columns:repeat(6,minmax(170px,1fr));gap:28px}.normal-node{position:relative;min-height:128px;padding:14px;border:2px solid var(--main);background:var(--surface)}.normal-node:not(:last-child)::after{content:"→";position:absolute;right:-21px;top:43%;color:var(--main);font:900 20px/1 var(--mono)}.normal-node b{display:block;color:var(--main);font:800 12px/1.35 var(--mono)}.normal-node span{display:block;margin-top:7px;color:var(--muted);font-size:12px}.fold-layer{position:absolute;top:24px;min-height:132px;padding:14px;border:2px dashed var(--cuda);background:rgba(195,108,255,.08);color:var(--cuda)}.fold-layer::after{content:"↓ 覆盖执行位置";position:absolute;left:50%;top:100%;height:58px;border-left:2px dashed var(--cuda);padding:7px;color:var(--cuda);font:800 11px/1.25 var(--mono);white-space:nowrap}.fold-layer b{display:block;font:800 12px/1.35 var(--mono)}.fold-layer span{display:block;margin-top:7px;color:#c9b0e8;font-size:12px}.fold-draft{left:18px;width:190px}.fold-accept{left:244px;width:590px}.fold-commit{right:210px;width:188px}.route-matrix{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.route-card{padding:14px;border:1px solid var(--line);background:var(--surface);transition:opacity .18s}.route-card[data-active="false"]{opacity:.25;filter:saturate(.2)}.route-card b{display:block;color:var(--guard)}.route-card span{display:block;margin-top:7px;color:var(--muted);font-size:12px}.guard-circuit{display:grid;grid-template-columns:repeat(7,minmax(155px,1fr));gap:25px;min-width:1240px;padding:15px 4px 25px}.guard-gate{--tone:var(--guard);position:relative;min-height:165px;padding:14px;border:2px dashed var(--tone);background:var(--surface)}.guard-gate[data-kind="cuda"]{--tone:var(--cuda)}.guard-gate[data-kind="main"]{--tone:var(--main);border-style:solid}.guard-gate:not(:last-child)::after{content:"是 →";position:absolute;right:-24px;top:38%;color:var(--main);font:800 11px/1 var(--mono)}.guard-gate b{display:block;color:var(--tone);font:800 12px/1.3 var(--mono)}.guard-gate span{display:block;margin-top:7px;color:var(--muted);font-size:12px}.guard-gate em{display:block;margin-top:10px;color:var(--fail);font:normal 11px/1.3 var(--mono)}.trust-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.trust-card{padding:15px;border:1px solid var(--data);background:var(--surface)}.trust-card[data-kind="guard"]{border-color:var(--guard);border-style:dashed}.trust-card b{display:block;color:var(--data)}.trust-card[data-kind="guard"] b{color:var(--guard)}.trust-card span{display:block;margin-top:7px;color:var(--muted);font-size:12px}.topic-link{display:block;margin-top:18px;padding:15px;border:1px dashed var(--cuda);background:rgba(195,108,255,.06);text-decoration:none}.topic-link b{display:block;color:var(--cuda)}.topic-link span{display:block;margin-top:6px;color:var(--muted);font-size:12px}@media(max-width:760px){.route-matrix,.trust-grid{grid-template-columns:1fr}}
  </style>
