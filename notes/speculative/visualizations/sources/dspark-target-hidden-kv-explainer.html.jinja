<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self' file: data:; style-src 'self' 'unsafe-inline' file:; script-src 'self' file:; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'">
  <title>07 · 隐藏状态 / Draft KV / 滚动锚点 · dSpark V2</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="assets/dspark-visual-system.css">
  <style>
    .invariant {
      max-width: 920px;
      margin-top: 22px;
      padding: 14px 16px;
      border-left: 5px solid var(--guard);
      background: rgba(255, 208, 96, .055);
      color: #d9e4f2;
    }
    .invariant b { color: var(--guard); font: 800 12px/1.3 var(--mono); }
    .invariant p { margin: 6px 0 0; font-size: 13px; }

    .step-copyline {
      min-height: 44px;
      margin: 0 0 14px;
      padding: 10px 12px;
      border-left: 4px solid var(--data);
      background: rgba(8, 17, 30, .8);
      color: #cbd9e9;
      font-size: 12px;
    }
    .step-copyline b { color: var(--data); font: 800 12px/1.3 var(--mono); }

    .rail-board {
      position: relative;
      min-width: 1130px;
      padding: 4px 0 154px;
    }
    .rail-board .rounds { min-width: 1130px; }
    .rounds__head { min-height: 64px; font-size: 12px; }
    .rounds__head:first-child { color: var(--ui); }
    .rounds__head small {
      display: block;
      margin-top: 4px;
      color: var(--faint);
      font: 12px/1.3 var(--mono);
    }
    .rounds__label { min-height: 86px; font-size: 12px; }
    .rounds__label strong { display: block; color: var(--data); }
    .rounds__label small { display: block; margin-top: 5px; color: var(--faint); font-size: 12px; }
    .rounds__cell {
      position: relative;
      display: grid;
      align-content: center;
      gap: 4px;
      min-height: 86px;
      font-size: 12px;
    }
    .rounds__cell b { font: 800 12px/1.25 var(--mono); }
    .rounds__cell small { color: inherit; opacity: .72; font: 12px/1.3 var(--mono); }
    .rounds__cell[data-step-state="active"] {
      background: color-mix(in srgb, currentColor 9%, var(--surface));
      box-shadow: inset 0 0 0 1px currentColor;
    }
    .rounds__cell[data-linked="true"] { z-index: 2; }

    .commit-boundary {
      border-left: 2px dashed var(--guard);
      border-right-color: var(--guard);
      background: rgba(255, 208, 96, .035);
    }
    .next-round-cell { background: rgba(93, 159, 255, .045); }
    .suffix-note { color: var(--off); font-style: normal; }

    .anchor-loop {
      position: absolute;
      left: 170px;
      right: 0;
      bottom: 12px;
      height: 122px;
      transition: opacity .2s, filter .2s;
    }
    .anchor-loop svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .anchor-loop__label {
      position: absolute;
      left: 13%;
      bottom: 7px;
      padding: 4px 8px;
      background: var(--bg);
      color: var(--guard);
      font: 800 12px/1.3 var(--mono);
    }
    .anchor-loop__draft {
      position: absolute;
      left: 2%;
      top: 5px;
      width: 270px;
      padding: 9px 11px;
      border: 1px solid var(--data);
      background: var(--surface);
      color: var(--muted);
      font: 12px/1.35 var(--mono);
      overflow-wrap: anywhere;
    }
    .anchor-loop__draft b { display: block; color: var(--data); }
    .anchor-loop__bonus {
      position: absolute;
      right: 2%;
      top: 5px;
      width: 210px;
      padding: 9px 11px;
      border: 1px dashed var(--guard);
      background: var(--surface);
      color: var(--guard);
      font: 800 12px/1.35 var(--mono);
      overflow-wrap: anywhere;
    }
    .loop-token {
      position: absolute;
      left: 0;
      top: 0;
      z-index: 3;
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      border: 2px solid var(--guard);
      border-radius: 50%;
      background: var(--bg);
      color: var(--guard);
      font: 900 12px/1 var(--mono);
      offset-path: path("M 920 28 C 920 110, 170 110, 170 34");
      offset-rotate: 0deg;
    }
    .anchor-loop[data-step-state="active"] .loop-token { animation: roll-anchor 1.4s ease-in-out infinite; }
    @keyframes roll-anchor { from { offset-distance: 0%; } to { offset-distance: 100%; } }

    .route-entry-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(230px, 1fr));
      gap: 12px;
      min-width: 820px;
      margin: 0 0 26px;
    }
    .route-entry {
      min-width: 0;
      padding: 11px 12px;
      border-top: 2px dashed var(--guard);
      border-bottom: 1px solid var(--line);
      transition: opacity .18s, filter .18s;
    }
    .route-entry b { display: block; color: var(--guard); font: 800 12px/1.3 var(--mono); }
    .route-entry span { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; }

    .pipeline-wrap { min-width: 1010px; }
    .pipeline { grid-template-columns: repeat(5, minmax(170px, 1fr)); min-width: 1010px; }
    .pipeline__node .instance { display: block; color: var(--tone); font: 800 12px/1.35 var(--mono); overflow-wrap: anywhere; }
    .pipeline__node .fqcn { display: block; margin-top: 6px; color: var(--faint); font: 12px/1.35 var(--mono); overflow-wrap: anywhere; }
    .pipeline__node .method { display: block; margin-top: 7px; color: #d8e5f4; font: 12px/1.4 var(--mono); overflow-wrap: anywhere; }
    .pipeline__node[data-kind="off"] { --tone: var(--off); border-style: dotted; }
    .kv-cells { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .kv-cell { padding: 3px; text-align: center; }

    .fanout-wrap {
      min-width: 1010px;
      margin-top: 42px;
      padding-top: 28px;
      border-top: 1px solid var(--line);
    }
    .fanout { min-width: 1010px; grid-template-columns: 220px repeat(3, minmax(220px, 1fr)); }
    .fanout__target[data-kind="main"] { border-color: var(--main); }
    .fanout b, .fanout span { font-size: 12px; }
    .fanout__target b { overflow-wrap: anywhere; }
    .fanout__target code { color: #d7e6f8; }
    .fanout__target a { color: var(--ui); }

    .early-publish {
      display: grid;
      grid-template-columns: repeat(5, minmax(170px, 1fr));
      gap: 22px;
      min-width: 1010px;
      margin-bottom: 28px;
    }
    .early-publish__node {
      position: relative;
      min-height: 112px;
      padding: 12px;
      border: 1px dashed var(--guard);
      background: var(--surface);
      color: var(--muted);
      font: 12px/1.4 var(--mono);
    }
    .early-publish__node:not(:last-child)::after {
      content: "→";
      position: absolute;
      right: -17px;
      top: 42%;
      color: var(--guard);
      font-weight: 900;
    }
    .early-publish__node b { display: block; color: var(--guard); }
    .early-publish__node[data-kind="main"] { border-color: var(--main); border-style: solid; }
    .early-publish__node[data-kind="main"] b { color: var(--main); }
    .early-publish__node[data-kind="data"] { border-color: var(--data); border-style: solid; }
    .early-publish__node[data-kind="data"] b { color: var(--data); }

    .source-details .callouts { margin-top: 12px; }

    @media (max-width: 900px) {
      .route-entry-grid { grid-template-columns: repeat(3, 250px); }
    }
    @media (max-width: 600px) {
      .invariant { padding: 12px; }
      .step-copyline { min-height: 58px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .anchor-loop[data-step-state="active"] .loop-token { animation: none; offset-distance: 100%; }
    }
  </style>
  <link rel="stylesheet" href="assets/dspark-source-studio.css">
  <script src="assets/dspark-site.js" defer></script>
  <script src="assets/dspark-learning-layer.js" defer></script>
